{
  "format_version": "1.8.0",
  "animations": {
    "animation.motor_critter.idle": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            { "0.0": [0, 0, 0] },
            { "2.0": [4, 6, 0] },
            { "4.0": [0, 0, 0] }
          ]
        },
        "tail": {
          "rotation": ["math.cos(q.life_time * 120) * 4", 0, 0]
        }
      }
    },
    "animation.motor_critter.walk": {
      "loop": true,
      "anim_time_update": "q.modified_distance_moved",
      "bones": {
        "leg_fl": { "rotation": ["math.cos(q.anim_time * 38.0) * 38", 0, 0] },
        "leg_fr": { "rotation": ["math.cos(q.anim_time * 38.0 + 180) * 38", 0, 0] },
        "leg_bl": { "rotation": ["math.cos(q.anim_time * 38.0 + 180) * 38", 0, 0] },
        "leg_br": { "rotation": ["math.cos(q.anim_time * 38.0) * 38", 0, 0] }
      }
    }
  }
}

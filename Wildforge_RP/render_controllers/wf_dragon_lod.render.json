{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.wf_dragon_lod": {
      "arrays": {
        "geometries": {
          "Array.geo": [
            "Geometry.default",
            "Geometry.lod"
          ]
        },
        "textures": {
          "Array.skin": [
            "Texture.default",
            "Texture.lod"
          ]
        }
      },
      "geometry": "Array.geo[(q.distance_from_camera > 64 ? 1 : 0)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skin[(q.distance_from_camera > 64 ? 1 : 0)]"
      ]
    }
  }
}
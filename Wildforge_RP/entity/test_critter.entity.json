{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "wf:test_critter",
      "materials": { "default": "entity_alphatest" },
      "textures": { "default": "textures/entity/wf_test_critter" },
      "geometry": { "default": "geometry.wf_test_critter" },
      "animations": {
        "idle": "animation.wf_critter.idle",
        "walk": "animation.wf_critter.walk"
      },
      "scripts": {
        "animate": [
          { "idle": "q.modified_move_speed <= 0.05" },
          { "walk": "q.modified_move_speed > 0.05" }
        ]
      },
      "render_controllers": ["controller.render.wf_default"],
      "spawn_egg": { "base_color": "#9b7653", "overlay_color": "#5c4630" }
    }
  }
}

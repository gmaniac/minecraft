{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "wf:capybara",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/wf_capybara"
      },
      "geometry": {
        "default": "geometry.wf_capybara"
      },
      "animations": {
        "idle": "animation.wf_pet.idle",
        "walk": "animation.wf_pet.walk"
      },
      "scripts": {
        "animate": [
          {
            "idle": "q.modified_move_speed <= 0.05"
          },
          {
            "walk": "q.modified_move_speed > 0.05"
          }
        ]
      },
      "render_controllers": [
        "controller.render.wf_default"
      ],
      "spawn_egg": {
        "base_color": "#8a6a44",
        "overlay_color": "#5a4226"
      }
    }
  }
}